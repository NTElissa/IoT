PORT=5000
NODE_ENV=development

# MongoDB connection string. Use a local instance or MongoDB Atlas.
MONGO_URI=mongodb://localhost:27017/tst5IVfluid
# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS - frontend origin
CLIENT_URL=http://localhost:5173

# Alert thresholds (percent)
LOW_FLUID_THRESHOLD=10
WARNING_FLUID_THRESHOLD=20
HIGH_FLUID_THRESHOLD=90

# Escalation window in minutes if an alert is not acknowledged
ESCALATION_MINUTES=10

# Simulation tick interval in milliseconds (how often fluid levels update)
SIMULATION_TICK_MS=8000

# Africa's Talking SMS gateway (optional).
# Leave blank to keep SMS simulated/logged to the console.
# Sign up at https://africastalking.com to get real credentials.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
AT_SANDBOX=true

# WebAuthn (fingerprint / passkey login). rpID must exactly match the
# hostname the frontend is served from (no scheme, no port) - the browser
# refuses to complete the ceremony otherwise. "localhost" works for local
# dev over http; anything else requires https.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=DripWatch
WEBAUTHN_ORIGIN=http://localhost:5173

# Google Sign-In. Create an OAuth 2.0 Client ID (Web application) at
# https://console.cloud.google.com/apis/credentials and add your frontend
# origin(s) to "Authorized JavaScript origins". Only users who already have
# an active account with a matching email can sign in this way - it never
# creates a new account.
GOOGLE_CLIENT_ID=

# Login security
MAX_LOGIN_ATTEMPTS=5
LOCK_MINUTES=15
